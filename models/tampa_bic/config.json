{
    "id": "tampa_bic",
    "title": {
        "pt": "Tampa BIC",
        "en": "BIC Cap"
    },
    "output_format": "3mf",
    "parts": [
        "base",
        "letters"
    ],
    "text_to_svg": true,
    "min_feature_size_mm": 0.8,
    "thin_wall_check": true,
    "parameters": [
        {
            "id": "text_line_1",
            "name": "Linha Primária",
            "type": "text",
            "default": "Catiele"
        },
        {
            "id": "text_size_1",
            "name": "Tamanho da Linha Primária",
            "type": "range",
            "min": 5,
            "max": 50,
            "step": 1,
            "default": 10,
            "unit": "mm"
        },
        {
            "id": "font_name",
            "name": "Fonte",
            "type": "select",
            "default": "Chewy:style=Regular",
            "options": [
                {
                    "value": "Chewy:style=Regular",
                    "label": "Chewy"
                },
                {
                    "value": "Bangers:style=Regular",
                    "label": "Bangers"
                },
                {
                    "value": "Leckerli One:style=Regular",
                    "label": "Leckerli One"
                },
                {
                    "value": "Pacifico:style=Regular",
                    "label": "Pacifico"
                },
                {
                    "value": "Comic Neue:style=Regular",
                    "label": "Comic Neue"
                },
                {
                    "value": "Oswald:style=Regular",
                    "label": "Oswald"
                }
            ]
        }
    ],
    "sections": [
        {
            "name": "Linha Secundária (Opcional)",
            "parameters": [
                {
                    "id": "text_line_2",
                    "name": "Linha Secundária",
                    "type": "text",
                    "placeholder": "Ex: Secretária",
                    "default": "Secretária"
                },
                {
                    "id": "text_size_2",
                    "name": "Tamanho da Linha Secundária",
                    "type": "range",
                    "min": 5,
                    "max": 50,
                    "step": 1,
                    "default": 10,
                    "unit": "mm"
                }
            ]
        },
        {
            "name": "Cores",
            "parameters": [
                {
                    "id": "base_color",
                    "name": "Cor da Base",
                    "type": "color",
                    "default": "#1B40D1"
                },
                {
                    "id": "letters_color",
                    "name": "Cor das Letras",
                    "type": "color",
                    "default": "#FFFFFF"
                }
            ]
        },
        {
            "name": "Ajustes Finos",
            "parameters": [
                {
                    "id": "letter_height",
                    "name": "Altura da letra",
                    "type": "range",
                    "min": 0.2,
                    "max": 10.0,
                    "step": 0.1,
                    "default": 1.2,
                    "unit": "mm"
                },
                {
                    "id": "base_height",
                    "name": "Altura da base",
                    "type": "range",
                    "min": 1,
                    "max": 50,
                    "step": 1,
                    "default": 13,
                    "unit": "mm"
                },
                {
                    "id": "outline_margin",
                    "name": "Margem do contorno",
                    "type": "range",
                    "min": 0,
                    "max": 10,
                    "step": 0.1,
                    "default": 2.5,
                    "unit": "mm"
                },
                {
                    "id": "spacing",
                    "name": "Espaçamento das letras",
                    "type": "range",
                    "min": 0.5,
                    "max": 2.0,
                    "step": 0.05,
                    "default": 1.0
                },
                {
                    "id": "line_spacing",
                    "name": "Distância entre linhas",
                    "type": "range",
                    "min": 0.1,
                    "max": 2.0,
                    "step": 0.05,
                    "default": 0.85
                },
                {
                    "id": "hole_diameter",
                    "name": "Diâmetro do furo da caneta",
                    "type": "range",
                    "min": 6,
                    "max": 12,
                    "step": 0.1,
                    "default": 8.1,
                    "unit": "mm"
                }
            ]
        }
    ]
}